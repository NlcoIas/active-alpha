# Active Alpha — Production Environment Variables
# Copy to .env and fill in values, or set in Coolify dashboard.

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
# For docker-compose internal networking, use the service name 'db'.
# For Coolify standalone DB, use the Coolify internal hostname.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/active_alpha
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:CHANGE_ME@db:5432/active_alpha
POSTGRES_DB=active_alpha
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── FMP API (Financial Modeling Prep) ─────────────────────────────────────
# Required for ETF holdings data. Get from financialmodelingprep.com
FMP_API_KEY=your_fmp_api_key_here

# ─── Admin ─────────────────────────────────────────────────────────────────
# Used to protect admin/pipeline endpoints
ADMIN_API_KEY=CHANGE_ME_RANDOM_STRING

# ─── Application ───────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
